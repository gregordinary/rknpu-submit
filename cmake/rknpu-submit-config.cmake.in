@PACKAGE_INIT@

# rknpu-submit exposes Threads::Threads through its public interface (the provider's
# per-file task buffer is mutex-guarded); re-find it so downstream
# find_package(rknpu-submit) consumers get a usable imported target.
include(CMakeFindDependencyMacro)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/rknpu-submit-targets.cmake")

check_required_components(rknpu-submit)
